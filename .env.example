# ============================================================
# AI 漫剧工作室 —— 环境变量模板
# 用法：
#   1. 复制本文件为 .env
#   2. 填入真实的 API Key
#   3. .env 已被 .gitignore 排除，不会入库
# ============================================================

# AIHubMix API Key（必填）
# 注册 / 获取：https://aihubmix.com
AIHUBMIX_API_KEY=sk-your-api-key-here

# 中转 Base URL（可选，默认 https://aihubmix.com/v1）
AIHUBMIX_BASE_URL=https://aihubmix.com/v1

# 生图模型（可选，默认 gpt-image-2）
MODEL=gpt-image-2
